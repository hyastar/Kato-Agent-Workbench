# Kato-Agent-Workbench 本地环境变量示例
#
# 复制为 .env 后按需填写；.env 已被 .gitignore 排除。
# 第一版所有 Python 工具都只使用标准库，不需要任何变量即可运行。
# 不要把真实 Token、Cookie、账号密码写进本文件或提交到 Git。

# 可选：覆盖默认数据库路径（相对于仓库根目录或绝对路径）
# KATO_DB_PATH=data/catalog/workbench.sqlite3

# 以下变量仅作人工记录，Playwright MCP 不会自动读取；实际参数写在 .codex/config.toml。
# 浏览器通道（chrome / msedge / firefox / webkit）
# KATO_BROWSER_CHANNEL=chrome

# 独立浏览器 Profile 目录（必须位于仓库之外）
# KATO_BROWSER_PROFILE=../.kato-playwright-profile
